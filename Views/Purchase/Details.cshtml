@model PharmacyManagement.Models.Purchase

@{
    ViewData["Title"] = "Purchase Details";
}

<div class="pm-purchase-details-page">

    <div class="pm-page-header-card mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="pm-page-header-icon">
                    #
                </span>

                <span class="text-primary small fw-semibold">
                    INVENTORY
                </span>

            </div>

            <h2 class="mb-1">
                Purchase Details
            </h2>

            <p class="text-muted mb-0">
                Purchase #@Model.PurchaseId
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                ← Back

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.PurchaseId"
               class="btn btn-outline-danger">

                Delete

            </a>

        </div>

    </div>


    <!-- Purchase Header -->

    <div class="pm-purchase-invoice-card mb-4">

        <div class="pm-purchase-invoice-top">

            <div>

                <span>
                    PURCHASE
                </span>

                <h3>
                    #@Model.PurchaseId
                </h3>

            </div>

            <div class="pm-purchase-total-box">

                <span>
                    Grand Total
                </span>

                <strong>
                    ₹@Model.TotalAmount.ToString("N2")
                </strong>

            </div>

        </div>


        <div class="pm-purchase-info-grid">

            <div>

                <span>
                    Supplier
                </span>

                <strong>
                    @Model.SupplierName
                </strong>

            </div>


            <div>

                <span>
                    Purchase Date
                </span>

                <strong>
                    @Model.PurchaseDate.ToString("dd-MM-yyyy")
                </strong>

            </div>


            <div>

                <span>
                    Invoice Number
                </span>

                <strong>
                    @(Model.InvoiceNo ?? "-")
                </strong>

            </div>


            <div>

                <span>
                    Purchase ID
                </span>

                <strong>
                    #@Model.PurchaseId
                </strong>

            </div>

        </div>

    </div>


    <!-- Items -->

    <div class="pm-purchase-invoice-card">

        <div class="pm-purchase-section-header">

            <div>

                <strong>
                    Purchased Medicines
                </strong>

                <small>
                    @Model.Items.Count item(s) in this purchase
                </small>

            </div>

        </div>


        @if (Model.Items.Count == 0)
        {
            <div class="text-center text-muted py-5">

                No purchase items found.

            </div>
        }
        else
        {
            <div class="pm-purchase-details-scroll">

                <table class="table pm-purchase-details-table">

                    <thead>

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Medicine
                            </th>

                            <th class="text-end">
                                Quantity
                            </th>

                            <th class="text-end">
                                Purchase Price
                            </th>

                            <th class="text-end">
                                Total
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    @item.PurchaseItemId
                                </td>

                                <td>

                                    <strong>
                                        @item.MedicineName
                                    </strong>

                                </td>

                                <td class="text-end">
                                    @item.Quantity
                                </td>

                                <td class="text-end">
                                    ₹@item.PurchasePrice.ToString("N2")
                                </td>

                                <td class="text-end">

                                    <strong>
                                        ₹@item.TotalPrice.ToString("N2")
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <th colspan="4"
                                class="text-end">

                                Grand Total

                            </th>

                            <th class="text-end pm-purchase-grand-value">

                                ₹@Model.TotalAmount.ToString("N2")

                            </th>

                        </tr>

                    </tfoot>

                </table>

            </div>
        }

    </div>

</div>