@model PharmacyManagement.Models.Purchase

@{
    ViewData["Title"] = "Delete Purchase";
}

<div class="mb-4">
    <h2>Delete Purchase</h2>
    <p class="text-muted">
        Review the purchase before deleting it.
    </p>
</div>

<div class="alert alert-warning">
    <strong>Warning:</strong>
    Deleting this purchase will also reverse the stock quantities
    that were added by this purchase.
</div>

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Purchase Information</strong>
    </div>

    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-4">
                Purchase ID
            </dt>

            <dd class="col-sm-8">
                @Model.PurchaseId
            </dd>


            <dt class="col-sm-4">
                Supplier
            </dt>

            <dd class="col-sm-8">
                @Model.SupplierName
            </dd>


            <dt class="col-sm-4">
                Purchase Date
            </dt>

            <dd class="col-sm-8">
                @Model.PurchaseDate.ToString("dd-MM-yyyy")
            </dd>


            <dt class="col-sm-4">
                Invoice No.
            </dt>

            <dd class="col-sm-8">
                @(Model.InvoiceNo ?? "-")
            </dd>


            <dt class="col-sm-4">
                Total Amount
            </dt>

            <dd class="col-sm-8">
                ₹@Model.TotalAmount.ToString("N2")
            </dd>

        </dl>

    </div>

</div>


<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Purchase Items</strong>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-bordered">

                <thead class="table-light">

                    <tr>
                        <th>Medicine</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Purchase Price</th>
                        <th class="text-end">Total</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        <tr>

                            <td>
                                @item.MedicineName
                            </td>

                            <td class="text-end">
                                @item.Quantity
                            </td>

                            <td class="text-end">
                                ₹@item.PurchasePrice.ToString("N2")
                            </td>

                            <td class="text-end">
                                ₹@item.TotalPrice.ToString("N2")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<form asp-action="DeleteConfirmed"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="id"
           value="@Model.PurchaseId" />

    <div class="d-flex justify-content-end gap-2">

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

        <button type="submit"
                class="btn btn-danger">
            Delete Purchase
        </button>

    </div>

</form>