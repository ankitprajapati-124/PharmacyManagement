@model PharmacyManagement.Models.Purchase

@{
    ViewData["Title"] = "Delete Purchase";
}

<div class="pm-purchase-delete-page">

    <div class="pm-delete-card">

        <div class="pm-purchase-delete-icon">
            !
        </div>

        <span class="pm-delete-label">
            STOCK REVERSAL
        </span>

        <h2>
            Delete This Purchase?
        </h2>

        <p>
            Deleting this purchase will remove the transaction
            and reverse the stock quantities that were added.
        </p>


        <div class="pm-purchase-delete-summary">

            <div>

                <span>
                    Purchase ID
                </span>

                <strong>
                    #@Model.PurchaseId
                </strong>

            </div>


            <div>

                <span>
                    Supplier
                </span>

                <strong>
                    @Model.SupplierName
                </strong>

            </div>


            <div>

                <span>
                    Invoice
                </span>

                <strong>
                    @(Model.InvoiceNo ?? "-")
                </strong>

            </div>


            <div>

                <span>
                    Total
                </span>

                <strong class="pm-delete-total">
                    ₹@Model.TotalAmount.ToString("N2")
                </strong>

            </div>

        </div>


        <div class="pm-delete-warning">

            <div class="pm-delete-warning-icon">
                !
            </div>

            <div>

                <strong>
                    Stock will be reduced
                </strong>

                <p>
                    The quantities added by this purchase
                    will be removed from the medicine inventory.
                </p>

            </div>

        </div>


        @if (Model.Items.Count > 0)
        {
            <div class="pm-delete-items">

                <strong>
                    Medicines affected
                </strong>

                <div class="pm-delete-item-list">

                    @foreach (var item in Model.Items)
                    {
                        <div class="pm-delete-item">

                            <span>
                                @item.MedicineName
                            </span>

                            <strong>
                                -@item.Quantity
                            </strong>

                        </div>
                    }

                </div>

            </div>
        }


        <form asp-action="DeleteConfirmed"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.PurchaseId" />

            <div class="pm-delete-actions">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-danger">

                    Delete & Reverse Stock

                </button>

            </div>

        </form>

    </div>

</div>