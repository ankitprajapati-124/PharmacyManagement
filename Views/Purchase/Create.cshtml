@model PharmacyManagement.Models.Purchase

@{
    ViewData["Title"] = "New Purchase";

    var suppliers = ViewBag.Suppliers
        as IEnumerable<PharmacyManagement.Models.Supplier>
        ?? Enumerable.Empty<PharmacyManagement.Models.Supplier>();

    var medicines = ViewBag.Medicines
        as IEnumerable<PharmacyManagement.Models.Medicine>
        ?? Enumerable.Empty<PharmacyManagement.Models.Medicine>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">New Purchase</h2>
        <p class="text-muted mb-0">
            Add medicines and increase stock.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back
    </a>
</div>

<form asp-action="Create"
      method="post"
      id="purchaseForm">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <!-- Purchase Information -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Purchase Information</strong>
        </div>

        <div class="card-body">

            <div class="row">

                <!-- Supplier -->

                <div class="col-md-4 mb-3">

                    <label asp-for="SupplierId"
                           class="form-label">
                        Supplier
                    </label>

                    <select asp-for="SupplierId"
                            class="form-select">

                        <option value="">
                            -- Select Supplier --
                        </option>

                        @foreach (var supplier in suppliers)
                        {
                            <option value="@supplier.SupplierId">
                                @supplier.SupplierName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="SupplierId"
                          class="text-danger">
                    </span>

                </div>

                <!-- Purchase Date -->

                <div class="col-md-4 mb-3">

                    <label asp-for="PurchaseDate"
                           class="form-label">
                        Purchase Date
                    </label>

                    <input asp-for="PurchaseDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="PurchaseDate"
                          class="text-danger">
                    </span>

                </div>

                <!-- Invoice -->

                <div class="col-md-4 mb-3">

                    <label asp-for="InvoiceNo"
                           class="form-label">
                        Invoice No.
                    </label>

                    <input asp-for="InvoiceNo"
                           class="form-control"
                           placeholder="e.g. INV-001" />

                    <span asp-validation-for="InvoiceNo"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- Purchase Items -->

    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <strong>Purchase Items</strong>

            <button type="button"
                    class="btn btn-sm btn-primary"
                    id="addItemBtn">
                + Add Medicine
            </button>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered align-middle"
                       id="itemsTable">

                    <thead class="table-light">

                        <tr>

                            <th style="width: 35%;">
                                Medicine
                            </th>

                            <th style="width: 15%;">
                                Quantity
                            </th>

                            <th style="width: 20%;">
                                Purchase Price
                            </th>

                            <th style="width: 20%;">
                                Total
                            </th>

                            <th style="width: 10%;">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody id="itemsBody">
                    </tbody>

                    <tfoot>

                        <tr>

                            <th colspan="3"
                                class="text-end">
                                Grand Total
                            </th>

                            <th>
                                ₹<span id="grandTotal">0.00</span>
                            </th>

                            <th></th>

                        </tr>

                    </tfoot>

                </table>

            </div>

            <div id="emptyMessage"
                 class="text-center text-muted py-4">

                No medicines added.

                <br />

                Click
                <strong>+ Add Medicine</strong>
                to add an item.

            </div>

        </div>

    </div>


    <!-- Actions -->

    <div class="d-flex justify-content-end gap-2">

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

        <button type="submit"
                class="btn btn-primary">
            Save Purchase
        </button>

    </div>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        // --------------------------------------------------
        // Medicine data from server
        // --------------------------------------------------

        const medicines = @Html.Raw(
                                    System.Text.Json.JsonSerializer.Serialize(
                                            medicines.Select(m => new
                                {
                                    id = m.MedicineId,
                                                    name = m.MedicineName
                                })
                    )
                    );

        let itemIndex = 0;


        // --------------------------------------------------
        // Create medicine dropdown options
        // --------------------------------------------------

        function createMedicineOptions() {
            let options =
                '<option value="">-- Select Medicine --</option>';

            medicines.forEach(function(medicine) {
                options +=
                    `<option value="${medicine.id}">
                                ${medicine.name}
                            </option>`;
            });

            return options;
        }


        // --------------------------------------------------
        // Calculate totals
        // --------------------------------------------------

        function updateTotals() {
            let grandTotal = 0;

            document
                .querySelectorAll(".purchase-item")
                .forEach(function(row) {
                    const quantity =
                        parseFloat(
                            row.querySelector(".quantity").value
                        ) || 0;

                    const price =
                        parseFloat(
                            row.querySelector(".purchase-price").value
                        ) || 0;

                    const total =
                        quantity * price;

                    row.querySelector(".item-total")
                        .textContent =
                        total.toFixed(2);

                    grandTotal += total;
                });

            document.getElementById("grandTotal")
                .textContent =
                grandTotal.toFixed(2);
        }


        // --------------------------------------------------
        // Empty message
        // --------------------------------------------------

        function updateEmptyMessage() {
            const rows =
                document.querySelectorAll(".purchase-item");

            const message =
                document.getElementById("emptyMessage");

            message.style.display =
                rows.length === 0
                    ? "block"
                    : "none";
        }


        // --------------------------------------------------
        // Add medicine row
        // --------------------------------------------------

        function addItem() {
            console.log("Add Medicine clicked");

            const tbody =
                document.getElementById("itemsBody");

            if (!tbody) {
                console.error("itemsBody not found.");
                return;
            }

            const row =
                document.createElement("tr");

            row.className =
                "purchase-item";

            row.innerHTML = `
                        <td>
                            <select
                                name="Items[${itemIndex}].MedicineId"
                                class="form-select medicine"
                                required>

                                ${createMedicineOptions()}

                            </select>
                        </td>

                        <td>
                            <input
                                type="number"
                                name="Items[${itemIndex}].Quantity"
                                class="form-control quantity"
                                min="1"
                                value="1"
                                required />
                        </td>

                        <td>
                            <input
                                type="number"
                                name="Items[${itemIndex}].PurchasePrice"
                                class="form-control purchase-price"
                                min="0"
                                step="0.01"
                                value="0"
                                required />
                        </td>

                        <td>
                            ₹<span class="item-total">0.00</span>
                        </td>

                        <td>
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-danger remove-item">

                                Remove

                            </button>
                        </td>
                    `;

            tbody.appendChild(row);

            itemIndex++;

            updateEmptyMessage();

            updateTotals();
        }


        // --------------------------------------------------
        // Page loaded
        // --------------------------------------------------

        document.addEventListener("DOMContentLoaded", function() {
            console.log("Purchase Create page loaded.");

            console.log(
                "Medicines received:",
                medicines
            );

            const addButton =
                document.getElementById("addItemBtn");

            if (!addButton) {
                console.error(
                    "Add Medicine button not found."
                );

                return;
            }

            addButton.addEventListener(
                "click",
                function() {
                    addItem();
                }
            );


            // --------------------------------------------------
            // Quantity / price changes
            // --------------------------------------------------

            document
                .getElementById("itemsBody")
                .addEventListener(
                    "input",
                    function() {
                        updateTotals();
                    }
                );


            // --------------------------------------------------
            // Remove medicine
            // --------------------------------------------------

            document
                .getElementById("itemsBody")
                .addEventListener(
                    "click",
                    function(event) {
                        if (
                            event.target.classList.contains(
                                "remove-item"
                            )
                        ) {
                            const row =
                                event.target.closest(
                                    ".purchase-item"
                                );

                            if (row) {
                                row.remove();

                                updateEmptyMessage();

                                updateTotals();
                            }
                        }
                    }
                );


            // --------------------------------------------------
            // Add first row automatically
            // --------------------------------------------------

            addItem();
        });

    </script>
}