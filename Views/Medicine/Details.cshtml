@model Medicine

@{
    ViewData["Title"] = "Medicine Details";

    var isExpired =
        Model.ExpiryDate.HasValue &&
        Model.ExpiryDate.Value.Date < DateTime.Today;

    var isExpiringSoon =
        Model.ExpiryDate.HasValue &&
        Model.ExpiryDate.Value.Date >= DateTime.Today &&
        Model.ExpiryDate.Value.Date <= DateTime.Today.AddDays(30);
}

<div class="pm-medicine-details-page">

    <div class="pm-page-header-card mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="pm-page-header-icon">
                    ◉
                </span>

                <span class="text-primary small fw-semibold">
                    MEDICINE DETAILS
                </span>

            </div>

            <h2 class="mb-1">
                @Model.MedicineName
            </h2>

            <p class="text-muted mb-0">
                Medicine ID #@Model.MedicineId
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.MedicineId"
               class="btn btn-primary">

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                ← Back

            </a>

        </div>

    </div>


    <!-- =========================================
         STATUS
         ========================================= -->

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="pm-detail-stat-card">

                <div class="pm-summary-icon pm-summary-blue">
                    ▦
                </div>

                <div>

                    <span>Current Stock</span>

                    <strong>
                        @Model.Quantity
                    </strong>

                    @if (Model.Quantity == 0)
                    {
                        <small class="text-danger">
                            Out of stock
                        </small>
                    }
                    else if (Model.Quantity < 10)
                    {
                        <small class="text-warning">
                            Low stock
                        </small>
                    }
                    else
                    {
                        <small class="text-success">
                            Healthy stock
                        </small>
                    }

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="pm-detail-stat-card">

                <div class="pm-summary-icon pm-summary-green">
                    ₹
                </div>

                <div>

                    <span>Selling Price</span>

                    <strong>
                        ₹@Model.SellingPrice.ToString("N2")
                    </strong>

                    <small>
                        Retail price
                    </small>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="pm-detail-stat-card">

                <div class="pm-summary-icon pm-summary-orange">
                    !
                </div>

                <div>

                    <span>Expiry</span>

                    <strong>

                        @(Model.ExpiryDate?
                            .ToString("dd-MM-yyyy")
                            ?? "-")

                    </strong>

                    @if (isExpired)
                    {
                        <small class="text-danger">
                            Expired
                        </small>
                    }
                    else if (isExpiringSoon)
                    {
                        <small class="text-warning">
                            Expiring soon
                        </small>
                    }
                    else
                    {
                        <small class="text-success">
                            Valid
                        </small>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         DETAILS
         ========================================= -->

    <div class="pm-detail-section-card">

        <div class="pm-detail-section-header">

            <strong>
                Medicine Information
            </strong>

        </div>


        <div class="pm-detail-grid">

            <div class="pm-detail-item">

                <span>
                    Medicine Name
                </span>

                <strong>
                    @Model.MedicineName
                </strong>

            </div>


            <div class="pm-detail-item">

                <span>
                    Manufacturer
                </span>

                <strong>
                    @(Model.Manufacturer ?? "-")
                </strong>

            </div>


            <div class="pm-detail-item">

                <span>
                    Category
                </span>

                <strong>
                    @(Model.CategoryName ?? "Not assigned")
                </strong>

            </div>


            <div class="pm-detail-item">

                <span>
                    Supplier
                </span>

                <strong>
                    @(Model.SupplierName ?? "Not assigned")
                </strong>

            </div>


            <div class="pm-detail-item">

                <span>
                    Batch Number
                </span>

                <strong>
                    @(Model.BatchNo ?? "-")
                </strong>

            </div>


            <div class="pm-detail-item">

                <span>
                    Expiry Date
                </span>

                <strong>
                    @(Model.ExpiryDate?
                        .ToString("dd-MM-yyyy")
                        ?? "-")
                </strong>

            </div>


            <div class="pm-detail-item">

                <span>
                    Purchase Price
                </span>

                <strong>
                    ₹@Model.PurchasePrice.ToString("N2")
                </strong>

            </div>


            <div class="pm-detail-item">

                <span>
                    Selling Price
                </span>

                <strong>
                    ₹@Model.SellingPrice.ToString("N2")
                </strong>

            </div>


            <div class="pm-detail-item">

                <span>
                    Quantity
                </span>

                <strong>
                    @Model.Quantity
                </strong>

            </div>

        </div>


        <div class="pm-detail-footer">

            <a asp-action="Edit"
               asp-route-id="@Model.MedicineId"
               class="btn btn-primary">

                Edit Medicine

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.MedicineId"
               class="btn btn-outline-danger">

                Delete Medicine

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                Back to Medicines

            </a>

        </div>

    </div>

</div>