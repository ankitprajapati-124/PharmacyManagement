@model Medicine

@{
    ViewData["Title"] = "Edit Medicine";
}

<div class="medicine-form-page">

    <div class="page-header-card mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="page-header-icon">
                    ✎
                </span>

                <span class="text-primary small fw-semibold">
                    INVENTORY
                </span>

            </div>

            <h2 class="mb-1">
                Edit Medicine
            </h2>

            <p class="text-muted mb-0">
                Update medicine information, stock and pricing.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            ← Back to Medicines

        </a>

    </div>


    <form asp-action="Edit"
          method="post">

        <input type="hidden"
               asp-for="MedicineId" />


        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>


        <div class="row g-4">

            <div class="col-lg-8">

                <div class="form-section-card">

                    <div class="form-section-header">

                        <div class="form-section-icon blue">
                            ✚
                        </div>

                        <div>

                            <strong>
                                Medicine Information
                            </strong>

                            <small>
                                Update the medicine details
                            </small>

                        </div>

                    </div>


                    <div class="form-section-body">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="MedicineName"
                                       class="form-label">
                                </label>

                                <input asp-for="MedicineName"
                                       class="form-control" />

                                <span asp-validation-for="MedicineName"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="Manufacturer"
                                       class="form-label">
                                </label>

                                <input asp-for="Manufacturer"
                                       class="form-control" />

                                <span asp-validation-for="Manufacturer"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="CategoryId"
                                       class="form-label">
                                    Category
                                </label>

                                <select asp-for="CategoryId"
                                        class="form-select">

                                    <option value="">
                                        -- Select Category --
                                    </option>

                                    @foreach (var category
                                        in ViewBag.Categories)
                                    {
                                        <option value="@category.CategoryId">

                                            @category.CategoryName

                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="SupplierId"
                                       class="form-label">
                                    Supplier
                                </label>

                                <select asp-for="SupplierId"
                                        class="form-select">

                                    <option value="">
                                        -- Select Supplier --
                                    </option>

                                    @foreach (var supplier
                                        in ViewBag.Suppliers)
                                    {
                                        <option value="@supplier.SupplierId">

                                            @supplier.SupplierName

                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="SupplierId"
                                      class="field-validation">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <div class="col-lg-4">

                <div class="form-info-card">

                    <div class="form-info-icon">
                        ✎
                    </div>

                    <h5>
                        Editing Medicine
                    </h5>

                    <p>
                        Medicine ID:
                        <strong>#@Model.MedicineId</strong>
                    </p>

                    <div class="info-line">

                        <span>
                            Current Stock
                        </span>

                        <strong>
                            @Model.Quantity
                        </strong>

                    </div>

                    <div class="info-line">

                        <span>
                            Selling Price
                        </span>

                        <strong>
                            ₹@Model.SellingPrice.ToString("N2")
                        </strong>

                    </div>

                </div>

            </div>


            <div class="col-12">

                <div class="form-section-card">

                    <div class="form-section-header">

                        <div class="form-section-icon green">
                            ▦
                        </div>

                        <div>

                            <strong>
                                Stock & Pricing
                            </strong>

                            <small>
                                Update inventory information
                            </small>

                        </div>

                    </div>


                    <div class="form-section-body">

                        <div class="row g-3">

                            <div class="col-md-4">

                                <label asp-for="BatchNo"
                                       class="form-label">
                                </label>

                                <input asp-for="BatchNo"
                                       class="form-control" />

                                <span asp-validation-for="BatchNo"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="ExpiryDate"
                                       class="form-label">
                                </label>

                                <input asp-for="ExpiryDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="ExpiryDate"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-4">

                                <label asp-for="Quantity"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <input asp-for="Quantity"
                                           type="number"
                                           min="0"
                                           class="form-control" />

                                    <span class="input-group-text">
                                        Units
                                    </span>

                                </div>

                                <span asp-validation-for="Quantity"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="PurchasePrice"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input asp-for="PurchasePrice"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control" />

                                </div>

                                <span asp-validation-for="PurchasePrice"
                                      class="field-validation">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="SellingPrice"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input asp-for="SellingPrice"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control" />

                                </div>

                                <span asp-validation-for="SellingPrice"
                                      class="field-validation">
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="form-section-footer">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            Save Changes

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}