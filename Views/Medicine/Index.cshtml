@model IReadOnlyList<Medicine>

@{
    ViewData["Title"] = "Medicines";

    var search =
        ViewData["Search"]?.ToString();

    var totalMedicines = Model.Count;

    var outOfStock =
        Model.Count(x => x.Quantity == 0);

    var lowStock =
        Model.Count(x =>
            x.Quantity > 0 &&
            x.Quantity < 10);

    var healthyStock =
        Model.Count(x =>
            x.Quantity >= 10);
}

<div class="pm-medicine-page">

    <!-- =========================================
         PAGE HEADER
         ========================================= -->

    <div class="pm-page-header-card mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="pm-page-header-icon">
                    ✚
                </span>

                <span class="text-primary small fw-semibold">
                    INVENTORY
                </span>

            </div>

            <h2 class="mb-1">
                Medicines
            </h2>

            <p class="text-muted mb-0">
                Manage your pharmacy medicine inventory,
                stock and pricing.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <span class="me-1">+</span>
            Add Medicine

        </a>

    </div>


    <!-- =========================================
         SUMMARY CARDS
         ========================================= -->

    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">

            <div class="pm-medicine-summary-card">

                <div class="pm-summary-icon pm-summary-blue">
                    ✚
                </div>

                <div>
                    <span>Total Medicines</span>

                    <strong>
                        @totalMedicines
                    </strong>
                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="pm-medicine-summary-card">

                <div class="pm-summary-icon pm-summary-green">
                    ✓
                </div>

                <div>
                    <span>Healthy Stock</span>

                    <strong>
                        @healthyStock
                    </strong>
                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="pm-medicine-summary-card">

                <div class="pm-summary-icon pm-summary-orange">
                    !
                </div>

                <div>
                    <span>Low Stock</span>

                    <strong>
                        @lowStock
                    </strong>
                </div>

            </div>

        </div>


        <div class="col-xl-3 col-md-6">

            <div class="pm-medicine-summary-card">

                <div class="pm-summary-icon pm-summary-red">
                    ×
                </div>

                <div>
                    <span>Out of Stock</span>

                    <strong>
                        @outOfStock
                    </strong>
                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         SEARCH
         ========================================= -->

    <div class="pm-medicine-toolbar mb-4">

        <form method="get"
              asp-action="Index"
              class="pm-medicine-search-form">

            <div class="pm-medicine-search-box">

                <span class="pm-search-icon">
                    ⌕
                </span>

                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control"
                       placeholder="Search by medicine name..." />

            </div>

            <button type="submit"
                    class="btn btn-primary">

                Search

            </button>

            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Clear

                </a>
            }

        </form>

        <div class="pm-medicine-count">

            <span>
                Showing
            </span>

            <strong>
                @Model.Count
            </strong>

            <span>
                medicine@(Model.Count == 1 ? "" : "s")
            </span>

        </div>

    </div>


    <!-- =========================================
         TABLE
         ========================================= -->
    @if (Model.Count == 0)
    {
        <div class="pm-medicine-empty-state">

            <div class="pm-empty-state-icon">
                ✚
            </div>

            <h4>
                No medicines found
            </h4>

            @if (!string.IsNullOrWhiteSpace(search))
            {
                <p>
                    No medicine matches
                    "<strong>@search</strong>".
                </p>

                <a asp-action="Index"
                   class="btn btn-outline-primary">

                    Clear Search

                </a>
            }
            else
            {
                <p>
                    Your medicine inventory is currently empty.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    + Add First Medicine

                </a>
            }

        </div>
    }
    else
    {
        <div class="pm-medicine-table-card">

            <div class="table-responsive">

                <table class="table pm-medicine-table">

                    <thead>

                        <tr>

                            <th>
                                Medicine
                            </th>

                            <th>
                                Manufacturer
                            </th>

                            <th>
                                Batch
                            </th>

                            <th>
                                Expiry
                            </th>

                            <th>
                                Purchase
                            </th>

                            <th>
                                Selling
                            </th>

                            <th>
                                Stock
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Supplier
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var medicine in Model)
                        {
                            var isExpired =
                                medicine.ExpiryDate.HasValue &&
                                medicine.ExpiryDate.Value.Date
                                    < DateTime.Today;

                            var isExpiringSoon =
                                medicine.ExpiryDate.HasValue &&
                                medicine.ExpiryDate.Value.Date >=
                                    DateTime.Today &&
                                medicine.ExpiryDate.Value.Date <=
                                    DateTime.Today.AddDays(30);

                            <tr>

                                <!-- MEDICINE -->

                                <td>

                                    <div class="pm-medicine-name-cell">

                                        <div class="pm-medicine-row-icon">
                                            ✚
                                        </div>

                                        <div>

                                            <strong>
                                                @medicine.MedicineName
                                            </strong>

                                            <small>
                                                ID #@medicine.MedicineId
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- MANUFACTURER -->

                                <td>
                                    @(medicine.Manufacturer ?? "-")
                                </td>


                                <!-- BATCH -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                        medicine.BatchNo))
                                    {
                                        <span class="pm-batch-badge">
                                            @medicine.BatchNo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- EXPIRY -->

                                <td>

                                    @if (isExpired)
                                    {
                                        <span class="pm-expiry-danger">

                                            <span>Expired</span>

                                            <small>
                                                @(medicine.ExpiryDate?
                                                .ToString("dd-MM-yyyy"))
                                            </small>

                                        </span>
                                    }
                                    else if (isExpiringSoon)
                                    {
                                        <span class="pm-expiry-warning">

                                            <span>
                                                Expiring Soon
                                            </span>

                                            <small>
                                                @(medicine.ExpiryDate?
                                                .ToString("dd-MM-yyyy"))
                                            </small>


                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pm-expiry-normal">

                                            @(medicine.ExpiryDate?
                                                .ToString("dd-MM-yyyy")
                                                ?? "-")

                                        </span>
                                    }

                                </td>


                                <!-- PURCHASE -->

                                <td class="pm-price-cell">

                                    ₹@medicine.PurchasePrice.ToString("N2")

                                </td>


                                <!-- SELLING -->

                                <td class="pm-price-cell pm-selling-price">

                                    ₹@medicine.SellingPrice.ToString("N2")

                                </td>


                                <!-- STOCK -->

                                <td>

                                    @if (medicine.Quantity == 0)
                                    {
                                        <span class="pm-stock-badge pm-stock-out">

                                            <span class="pm-stock-dot"></span>

                                            Out of stock

                                        </span>
                                    }
                                    else if (medicine.Quantity < 10)
                                    {
                                        <span class="pm-stock-badge pm-stock-low">

                                            <span class="pm-stock-dot"></span>

                                            Low · @medicine.Quantity

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="pm-stock-badge pm-stock-good">

                                            <span class="pm-stock-dot"></span>

                                            @medicine.Quantity

                                        </span>
                                    }

                                </td>


                                <!-- CATEGORY -->

                                <td>

                                    @(medicine.CategoryName ?? "-")

                                </td>


                                <!-- SUPPLIER -->

                                <td>

                                    @(medicine.SupplierName ?? "-")

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-end">

                                    <div class="pm-medicine-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@medicine.MedicineId"
                                           class="pm-action-btn pm-action-view"
                                           title="View Details">

                                            View

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@medicine.MedicineId"
                                           class="pm-action-btn pm-action-edit"
                                           title="Edit Medicine">

                                            Edit

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@medicine.MedicineId"
                                           class="pm-action-btn pm-action-delete"
                                           title="Delete Medicine">

                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>