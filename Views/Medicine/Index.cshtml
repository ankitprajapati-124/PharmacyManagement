@model IReadOnlyList<Medicine>

@{
    ViewData["Title"] = "Medicines";
    var search = ViewData["Search"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">Medicines</h1>
        <p class="text-muted mb-0">Medicine inventory management</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Add Medicine
    </a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-8">
        <input type="text"
               name="search"
               value="@search"
               class="form-control"
               placeholder="Search medicine name..." />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">
            Search
        </button>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Clear
        </a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No medicines found.
    </div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Manufacturer</th>
                    <th>Batch</th>
                    <th>Expiry</th>
                    <th>Purchase</th>
                    <th>Selling</th>
                    <th>Stock</th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var medicine in Model)
            {
                <tr>

                    <td class="fw-semibold">@medicine.MedicineName</td>
                    <td>@medicine.Manufacturer</td>
                    <td>@medicine.BatchNo</td>
                    <td>
                        @(medicine.ExpiryDate?.ToString("dd-MM-yyyy") ?? "-")
                    </td>
                    <td>₹@medicine.PurchasePrice.ToString("N2")</td>
                    <td>₹@medicine.SellingPrice.ToString("N2")</td>
                    <td>
                        @if (medicine.Quantity == 0)
                        {
                            <span class="badge text-bg-danger">Out of stock</span>
                        }
                        else if (medicine.Quantity < 10)
                        {
                            <span class="badge text-bg-warning">
                                Low: @medicine.Quantity
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">
                                @medicine.Quantity
                            </span>
                        }
                    </td>
                        <td>
                            @medicine.CategoryName
                        </td>

                        <td>
                            @medicine.SupplierName
                        </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details"
                           asp-route-id="@medicine.MedicineId"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>
                        <a asp-action="Edit"
                           asp-route-id="@medicine.MedicineId"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@medicine.MedicineId"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
