@model Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<div class="pm-delete-page">

    <div class="pm-delete-card">

        <div class="pm-delete-icon">
            !
        </div>

        <div class="pm-delete-content">

            <span class="pm-delete-label">
                MEDICINE MANAGEMENT
            </span>

            <h2>
                Deactivate Medicine?
            </h2>

            <p>
                You are about to deactivate
                <strong>@Model.MedicineName</strong>.
            </p>

            <div class="pm-delete-medicine-info">

                <div>

                    <span>
                        Medicine
                    </span>

                    <strong>
                        @Model.MedicineName
                    </strong>

                </div>

                <div>

                    <span>
                        Batch
                    </span>

                    <strong>
                        @(Model.BatchNo ?? "-")
                    </strong>

                </div>

                <div>

                    <span>
                        Current Stock
                    </span>

                    <strong>
                        @Model.Quantity
                    </strong>

                </div>

            </div>

            <div class="pm-delete-warning">

                <strong>
                    Important
                </strong>

                <p>
                    This action uses a soft delete.
                    Historical records will be preserved,
                    but this medicine will no longer be active
                    in the inventory.
                </p>

            </div>


            <form asp-action="DeleteConfirmed"
                  method="post"
                  class="pm-delete-actions">

                <input type="hidden"
                       name="id"
                       value="@Model.MedicineId" />

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-danger">

                    Yes, Deactivate

                </button>

            </form>

        </div>

    </div>

</div>