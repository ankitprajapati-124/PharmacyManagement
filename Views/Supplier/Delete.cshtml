@model PharmacyManagement.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";

    var initial =
        string.IsNullOrWhiteSpace(Model.SupplierName)
            ? "?"
            : Model.SupplierName.Trim()
                .Substring(0, 1)
                .ToUpperInvariant();
}

<div class="pm-supplier-delete-page">

    <div class="pm-supplier-form-top">

        <a asp-action="Index"
           class="pm-supplier-back">
            ← Back to Suppliers
        </a>

        <div class="pm-supplier-form-heading">

            <div class="pm-supplier-form-icon red">
                !
            </div>

            <div>

                <div class="pm-supplier-eyebrow danger">
                    DANGER ZONE
                </div>

                <h1>Delete Supplier</h1>

                <p>
                    Review the supplier before deleting it.
                </p>

            </div>

        </div>

    </div>


    <div class="pm-supplier-delete-card">


        <!-- WARNING -->

        <div class="pm-supplier-delete-warning">

            <div class="pm-supplier-warning-icon">
                !
            </div>

            <div>

                <h2>
                    Are you sure?
                </h2>

                <p>
                    You are about to permanently delete this supplier.
                    This action cannot be undone.
                </p>

            </div>

        </div>


        <!-- DETAILS -->

        <div class="pm-supplier-delete-body">

            <div class="pm-supplier-delete-item">

                <div class="pm-supplier-delete-avatar">
                    @initial
                </div>

                <div class="pm-supplier-delete-info">

                    <span>
                        Supplier
                    </span>

                    <strong>
                        @Model.SupplierName
                    </strong>

                    <small>
                        Supplier ID: #@Model.SupplierId
                    </small>

                </div>

            </div>


            <div class="pm-supplier-delete-details">

                <div>

                    <span>
                        Phone
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Phone)
                            ? "-"
                            : Model.Phone)
                    </strong>

                </div>


                <div>

                    <span>
                        Email
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Email)
                            ? "-"
                            : Model.Email)
                    </strong>

                </div>

            </div>


            <div class="pm-supplier-delete-note">

                <span>!</span>

                <div>

                    <strong>
                        Permanent deletion
                    </strong>

                    <p>
                        Make sure this supplier is no longer required
                        before continuing.
                    </p>

                </div>

            </div>

        </div>


        <!-- FOOTER -->

        <form asp-action="DeleteConfirmed"
              method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.SupplierId" />

            <div class="pm-supplier-delete-footer">

                <a asp-action="Index"
                   class="pm-supplier-secondary-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="pm-supplier-danger-btn">
                    × Yes, Delete Supplier
                </button>

            </div>

        </form>

    </div>

</div>