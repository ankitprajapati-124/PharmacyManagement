@model PharmacyManagement.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="container mt-4">

    <h1>Delete Supplier</h1>

    <div class="alert alert-warning">
        Are you sure you want to delete this supplier?
    </div>

    <div class="card">

        <div class="card-body">

            <h5 class="card-title">
                @Model.SupplierName
            </h5>

            <p>
                Supplier ID: @Model.SupplierId
            </p>

            <p>
                Phone: @Model.Phone
            </p>

            <p>
                Email: @Model.Email
            </p>

            <form asp-action="DeleteConfirmed"
                  method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.SupplierId" />

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>