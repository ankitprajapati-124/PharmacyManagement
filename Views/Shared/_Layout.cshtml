<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Pharmacy Management</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    @{
        var currentController =
            ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

        var currentAction =
            ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        var isAccountPage =
            string.Equals(
                currentController,
                "Account",
                StringComparison.OrdinalIgnoreCase);

        var displayName =
            User.FindFirst(
                System.Security.Claims.ClaimTypes.GivenName
            )?.Value
            ?? User.Identity?.Name
            ?? "User";

        var role =
            User.FindFirst(
                System.Security.Claims.ClaimTypes.Role
            )?.Value
            ?? "User";

        var displayInitial =
            string.IsNullOrWhiteSpace(displayName)
                ? "U"
                : displayName.Trim().Substring(0, 1).ToUpperInvariant();
    }


    @if (!isAccountPage && User.Identity?.IsAuthenticated == true)
    {
        <div class="pm-app-shell">

            <!-- ========================= -->
            <!-- SIDEBAR -->
            <!-- ========================= -->

            <aside class="pm-sidebar" id="sidebar">

                <div class="pm-sidebar-brand">

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="pm-brand-link">

                        <span class="pm-brand-icon">
                            <img src="~/images/logo.png"
                                 alt="Pharmacy Management Logo" />
                        </span>

                        <span>
                            <strong>Pharmacy</strong>
                            <small>Management</small>
                        </span>

                    </a>

                    <button type="button"
                            class="pm-sidebar-close"
                            id="sidebarClose">
                        ×
                    </button>

                </div>


                <!-- USER PROFILE -->

                <div class="pm-sidebar-user">

                    <div class="pm-user-avatar">
                        @displayInitial
                    </div>

                    <div class="pm-user-info">

                        <strong>
                            @displayName
                        </strong>

                        <span>
                            @role
                        </span>

                    </div>

                </div>


                <!-- NAVIGATION -->

                <div class="pm-sidebar-section">
                    <span>MAIN MENU</span>
                </div>

                <nav class="pm-sidebar-nav">

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="pm-sidebar-link @(currentController == "Dashboard" ? "pm-active" : "")">

                        <span class="pm-nav-icon">⌂</span>
                        <span>Dashboard</span>

                    </a>


                    <a asp-controller="Medicine"
                       asp-action="Index"
                       class="pm-sidebar-link @(currentController == "Medicine" ? "pm-active" : "")">

                        <span class="pm-nav-icon">✚</span>
                        <span>Medicines</span>

                    </a>


                    <a asp-controller="Sale"
                       asp-action="Index"
                       class="pm-sidebar-link @(currentController == "Sale" ? "pm-active" : "")">

                        <span class="pm-nav-icon">▣</span>
                        <span>Sales</span>

                    </a>


                    @if (User.IsInRole("Admin") ||
                         User.IsInRole("Pharmacist"))
                    {
                        <a asp-controller="Purchase"
                           asp-action="Index"
                           class="pm-sidebar-link @(currentController == "Purchase" ? "pm-active" : "")">

                            <span class="pm-nav-icon">▤</span>
                            <span>Purchases</span>

                        </a>


                        <a asp-controller="Category"
                           asp-action="Index"
                           class="pm-sidebar-link @(currentController == "Category" ? "pm-active" : "")">

                            <span class="pm-nav-icon">◈</span>
                            <span>Categories</span>

                        </a>


                        <a asp-controller="Supplier"
                           asp-action="Index"
                           class="pm-sidebar-link @(currentController == "Supplier" ? "pm-active" : "")">

                            <span class="pm-nav-icon">♧</span>
                            <span>Suppliers</span>

                        </a>
                    }


                    @if (User.IsInRole("Admin") ||
                         User.IsInRole("Pharmacist"))
                    {
                        <div class="pm-sidebar-section mt-3">
                            <span>REPORTS</span>
                        </div>

                        <a asp-controller="Reports"
                           asp-action="Sales"
                           class="pm-sidebar-link @(currentController == "Reports" && currentAction == "Sales" ? "pm-active" : "")">

                            <span class="pm-nav-icon">↗</span>
                            <span>Sales Report</span>

                        </a>


                        <a asp-controller="Reports"
                           asp-action="Purchases"
                           class="pm-sidebar-link @(currentController == "Reports" && currentAction == "Purchases" ? "pm-active" : "")">

                            <span class="pm-nav-icon">↗</span>
                            <span>Purchase Report</span>

                        </a>


                        <a asp-controller="Reports"
                           asp-action="Stock"
                           class="pm-sidebar-link @(currentController == "Reports" && currentAction == "Stock" ? "pm-active" : "")">

                            <span class="pm-nav-icon">▥</span>
                            <span>Stock Report</span>

                        </a>
                    }


                    @if (User.IsInRole("Admin"))
                    {
                        <div class="pm-sidebar-section mt-3">
                            <span>ADMINISTRATION</span>
                        </div>

                        <a asp-controller="Users"
                           asp-action="Index"
                           class="pm-sidebar-link @(currentController == "Users" ? "pm-active" : "")">

                            <span class="pm-nav-icon">♙</span>
                            <span>Users</span>

                        </a>


                        <a asp-controller="AuditLogs"
                           asp-action="Index"
                           class="pm-sidebar-link @(currentController == "AuditLogs" ? "pm-active" : "")">

                            <span class="pm-nav-icon">▤</span>
                            <span>Audit Logs</span>

                        </a>
                    }

                </nav>


                <!-- SIDEBAR FOOTER -->

                <div class="pm-sidebar-footer">

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="pm-logout-link">

                            <span class="pm-nav-icon">←</span>

                            <span>
                                Logout
                            </span>

                        </button>

                    </form>

                </div>

            </aside>


            <!-- ========================= -->
            <!-- MAIN AREA -->
            <!-- ========================= -->

            <div class="pm-main-area">

                <!-- TOPBAR -->

                <header class="pm-topbar">

                    <button type="button"
                            class="pm-sidebar-toggle"
                            id="sidebarToggle">
                        ☰
                    </button>

                    <div class="pm-topbar-title">

                        <span>
                            @ViewData["Title"]
                        </span>

                    </div>


                    <div class="pm-topbar-user">

                        <div class="pm-topbar-avatar">
                            @displayInitial
                        </div>

                        <div class="pm-topbar-user-info">

                            <strong>
                                @displayName
                            </strong>

                            <small>
                                @role
                            </small>

                        </div>

                    </div>

                </header>


                <!-- PAGE -->

                <main class="pm-page-content">

                    @if (TempData["Success"] is string message)
                    {
                        <div class="alert alert-success pm-custom-alert alert-dismissible fade show"
                             role="alert">

                            <span class="alert-icon">✓</span>

                            <span>
                                @message
                            </span>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>

                        </div>
                    }


                    @if (TempData["Error"] is string errorMessage)
                    {
                        <div class="alert alert-danger pm-custom-alert alert-dismissible fade show"
                             role="alert">

                            <span class="alert-icon">!</span>

                            <span>
                                @errorMessage
                            </span>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert">
                            </button>

                        </div>
                    }


                    @RenderBody()

                </main>


                <footer class="pm-app-footer">

                    <span>
                        © @DateTime.Now.Year Pharmacy Management System
                    </span>

                    <span>
                        Pharmacy Administration
                    </span>

                </footer>

            </div>

        </div>
    }
    else
    {
        <!-- ACCOUNT PAGES -->

        <main class="pm-account-layout">

            @if (TempData["Success"] is string message)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">

                    @message

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">

                    @errorMessage

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            @RenderBody()

        </main>
    }


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>


    <script>

            const sidebar =
                document.getElementById("sidebar");

            const sidebarToggle =
                document.getElementById("sidebarToggle");

            const sidebarClose =
                document.getElementById("sidebarClose");

            const sidebarNav =
                document.querySelector(".pm-sidebar-nav");

            if (sidebarToggle) {

                sidebarToggle.addEventListener(
                    "click",
                    function() {

                        sidebar.classList.add("pm-sidebar-open");

                    });

            }


            if (sidebarClose) {

                sidebarClose.addEventListener(
                    "click",
                    function() {

                        sidebar.classList.remove("pm-sidebar-open");

                    });

            }


            document.addEventListener(
                "click",
                function(event) {

                    if (
                        window.innerWidth <= 992 &&
                        sidebar &&
                        sidebar.classList.contains("pm-sidebar-open") &&
                        !sidebar.contains(event.target) &&
                        event.target !== sidebarToggle
                    ) {

                        sidebar.classList.remove("pm-sidebar-open");

                    }

                });
            // =========================================
            // SIDEBAR SCROLLBAR
            // Show only while sidebar is scrolling
            // =========================================

            if (sidebarNav) {

                let sidebarScrollTimer;

                sidebarNav.addEventListener("scroll", function() {

                    sidebarNav.classList.add("is-scrolling");

                    clearTimeout(sidebarScrollTimer);

                    sidebarScrollTimer = setTimeout(function() {

                        sidebarNav.classList.remove("is-scrolling");

                    }, 700);

                });

            }
    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>