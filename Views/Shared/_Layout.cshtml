<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Pharmacy Management</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">

        <div class="container">

            <!-- Brand -->
            <a class="navbar-brand fw-bold"
               asp-controller="Dashboard"
               asp-action="Index">
                Pharmacy Management
            </a>

            <!-- Navigation -->
            <div class="navbar-nav">

                <a class="nav-link"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    Dashboard
                </a>

                <a class="nav-link"
                   asp-controller="Medicine"
                   asp-action="Index">
                    Medicines
                </a>

                <a class="nav-link"
                   asp-controller="Category"
                   asp-action="Index">
                    Categories
                </a>

                <a class="nav-link"
                   asp-controller="Supplier"
                   asp-action="Index">
                    Suppliers
                </a>

            </div>

        </div>

    </nav>


    <!-- Main Content -->
    <main class="container py-4">

        @if (TempData["Success"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show">

                @message

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show">

                @errorMessage

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @RenderBody()

    </main>


    <!-- Footer -->
    <footer class="border-top text-muted py-3">

        <div class="container">
            Pharmacy Management System
        </div>

    </footer>


    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>