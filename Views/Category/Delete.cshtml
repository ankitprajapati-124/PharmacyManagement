@model PharmacyManagement.Models.Category

@{
    ViewData["Title"] = "Delete Category";

    var initial =
        string.IsNullOrWhiteSpace(Model.CategoryName)
            ? "?"
            : Model.CategoryName.Substring(0, 1).ToUpper();
}

<div class="pm-catui-delete-page">

    <!-- TOP -->
    <div class="pm-catui-form-top">

        <a asp-action="Index"
           class="pm-catui-back">
            ← Back to Categories
        </a>


        <div class="pm-catui-form-heading">

            <div class="pm-catui-form-icon pm-red">
                !
            </div>

            <div>

                <div class="pm-catui-eyebrow pm-catui-eyebrow-danger">
                    DANGER ZONE
                </div>

                <h1>Delete Category</h1>

                <p>
                    Review the category before deleting it.
                </p>

            </div>

        </div>

    </div>


    <!-- DELETE CARD -->
    <div class="pm-catui-delete-card">

        <!-- WARNING -->
        <div class="pm-catui-delete-warning">

            <div class="pm-catui-warning-icon">
                !
            </div>

            <div>

                <h2>Are you sure?</h2>

                <p>
                    You are about to permanently delete this category.
                    This action cannot be undone.
                </p>

            </div>

        </div>


        <!-- CATEGORY INFORMATION -->
        <div class="pm-catui-delete-body">

            <div class="pm-catui-delete-item">

                <div class="pm-catui-delete-avatar">
                    @initial
                </div>

                <div class="pm-catui-delete-info">

                    <span>Category</span>

                    <strong>
                        @Model.CategoryName
                    </strong>

                    <small>
                        Category ID: #@Model.CategoryId
                    </small>

                </div>

            </div>


            <div class="pm-catui-delete-note">

                <span>!</span>

                <div>

                    <strong>
                        Permanent deletion
                    </strong>

                    <p>
                        Make sure this category is no longer required
                        before continuing.
                    </p>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->
        <form asp-action="DeleteConfirmed"
              method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.CategoryId" />

            <div class="pm-catui-delete-footer">

                <a asp-action="Index"
                   class="pm-catui-secondary-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="pm-catui-danger-btn">

                    <span>
                        ×
                    </span>

                    Yes, Delete Category

                </button>

            </div>

        </form>

    </div>

</div>