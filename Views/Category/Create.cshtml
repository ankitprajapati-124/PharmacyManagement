@model PharmacyManagement.Models.Category

@{
    ViewData["Title"] = "Add Category";
}

<div class="container mt-4">

    <h1>Add Category</h1>

    <form asp-action="Create" method="post">

        <div class="mb-3">

            <label asp-for="CategoryName"
                   class="form-label">
                Category Name
            </label>

            <input asp-for="CategoryName"
                   class="form-control" />

            <span asp-validation-for="CategoryName"
                  class="text-danger">
            </span>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Save Category
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>