@model PharmacyManagement.Models.StockReportViewModel

@{
    ViewData["Title"] = "Stock Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2>Stock Report</h2>

        <p class="text-muted mb-0">
            View current medicine inventory, stock levels and expiry status.
        </p>
    </div>

</div>


<!-- SUMMARY CARDS -->

<div class="row g-4 mb-4">

    <div class="col-md-4">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <h6 class="text-muted">
                    Total Medicines
                </h6>

                <h2 class="mb-0">
                    @Model.TotalMedicines
                </h2>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <h6 class="text-muted">
                    Total Stock Quantity
                </h6>

                <h2 class="mb-0">
                    @Model.TotalStockQuantity
                </h2>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <h6 class="text-muted">
                    Total Stock Value
                </h6>

                <h2 class="mb-0 text-primary">
                    ₹@Model.TotalStockValue.ToString("N2")
                </h2>

            </div>

        </div>

    </div>

</div>


<!-- STATUS CARDS -->

<div class="row g-4 mb-4">

    <div class="col-md-4">

        <div class="card shadow-sm border-warning h-100">

            <div class="card-body">

                <h6 class="text-muted">
                    Low Stock
                </h6>

                <h2 class="mb-0 text-warning">
                    @Model.LowStockCount
                </h2>

                <small class="text-muted">
                    Quantity between 1 and 10
                </small>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="card shadow-sm border-danger h-100">

            <div class="card-body">

                <h6 class="text-muted">
                    Out of Stock
                </h6>

                <h2 class="mb-0 text-danger">
                    @Model.OutOfStockCount
                </h2>

                <small class="text-muted">
                    Quantity is zero
                </small>

            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="card shadow-sm border-warning h-100">

            <div class="card-body">

                <h6 class="text-muted">
                    Expiring Soon
                </h6>

                <h2 class="mb-0 text-warning">
                    @Model.ExpiringSoonCount
                </h2>

                <small class="text-muted">
                    Expiring within 30 days
                </small>

            </div>

        </div>

    </div>

</div>


<!-- STOCK TABLE -->

<div class="card shadow-sm">

    <div class="card-header bg-white">

        <strong>
            Current Medicine Stock
        </strong>

    </div>

    <div class="card-body p-0">

        @if (Model.Medicines.Count == 0)
        {
            <div class="p-4 text-center text-muted">

                No active medicines found.

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Medicine</th>

                            <th>Category</th>

                            <th>Supplier</th>

                            <th>Batch</th>

                            <th>Expiry</th>

                            <th class="text-end">
                                Quantity
                            </th>

                            <th class="text-end">
                                Purchase Price
                            </th>

                            <th class="text-end">
                                Selling Price
                            </th>

                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var medicine in Model.Medicines)
                        {
                            var isOutOfStock =
                                medicine.Quantity == 0;

                            var isLowStock =
                                medicine.Quantity > 0 &&
                                medicine.Quantity <= 10;

                            var isExpired =
                                medicine.ExpiryDate.HasValue &&
                                medicine.ExpiryDate.Value.Date <
                                DateTime.Today;

                            var isExpiringSoon =
                                medicine.ExpiryDate.HasValue &&
                                medicine.ExpiryDate.Value.Date >=
                                DateTime.Today &&
                                medicine.ExpiryDate.Value.Date <=
                                DateTime.Today.AddDays(30);

                            <tr>

                                <td>
                                    <strong>
                                        @medicine.MedicineName
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        medicine.Manufacturer))
                                    {
                                        <br />

                                        <small class="text-muted">
                                            @medicine.Manufacturer
                                        </small>
                                    }
                                </td>

                                <td>
                                    @(medicine.CategoryName ?? "-")
                                </td>

                                <td>
                                    @(medicine.SupplierName ?? "-")
                                </td>

                                <td>
                                    @(medicine.BatchNo ?? "-")
                                </td>

                                <td>
                                    @if (medicine.ExpiryDate.HasValue)
                                    {
                                        <span>
                                            @(medicine.ExpiryDate.Value.ToString("dd-MM-yyyy"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                </td>

                                <td class="text-end fw-semibold">

                                    @medicine.Quantity

                                </td>

                                <td class="text-end">

                                    ₹@medicine.PurchasePrice.ToString("N2")

                                </td>

                                <td class="text-end">

                                    ₹@medicine.SellingPrice.ToString("N2")

                                </td>

                                <td>

                                    @if (isExpired)
                                    {
                                        <span class="badge bg-danger">
                                            Expired
                                        </span>
                                    }
                                    else if (isOutOfStock)
                                    {
                                        <span class="badge bg-danger">
                                            Out of Stock
                                        </span>
                                    }
                                    else if (isExpiringSoon)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Expiring Soon
                                        </span>
                                    }
                                    else if (isLowStock)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            In Stock
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>