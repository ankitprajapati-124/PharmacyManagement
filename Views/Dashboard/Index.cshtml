@{
    ViewData["Title"] = "Dashboard";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
    <div class="container-fluid py-3">
        <h1 class="display-6 fw-bold">Pharmacy Management System</h1>
        <p class="lead">
            ASP.NET Core MVC + C# + ADO.NET + SQL Server
        </p>
        <a class="btn btn-primary btn-lg"
           asp-controller="Medicine"
           asp-action="Index">
            Manage Medicines
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Medicines</h5>
                <p class="card-text">
                    Add, edit, search and manage medicine stock.
                </p>
                <a asp-controller="Medicine"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Open
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Purchases</h5>
                <p class="card-text">
                    Purchase and supplier modules will be added next.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Sales</h5>
                <p class="card-text">
                    Sales, invoices and stock transactions will be added next.
                </p>
            </div>
        </div>
    </div>
</div>
