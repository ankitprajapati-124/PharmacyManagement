@model PharmacyManagement.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var displayName =
        User.FindFirst(
            System.Security.Claims.ClaimTypes.GivenName
        )?.Value
        ?? User.Identity?.Name
        ?? "User";

    var role =
        User.FindFirst(
            System.Security.Claims.ClaimTypes.Role
        )?.Value
        ?? "User";
}


<!-- =========================================
     DASHBOARD HEADER
     ========================================= -->

<div class="dashboard-heading mb-4">

    <div class="d-flex justify-content-between align-items-center">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="status-dot"></span>

                <span class="text-success small fw-semibold">
                    System Online
                </span>

            </div>

            <h2 class="mb-1">
                Good day, @displayName 👋
            </h2>

            <p class="text-muted mb-0">
                Here's what's happening in your pharmacy today.
            </p>

        </div>


        <!-- QUICK CREATE -->

        <div class="d-flex gap-2">

            <a asp-controller="Sale"
               asp-action="Create"
               class="btn btn-success">

                + New Sale

            </a>

            @if (User.IsInRole("Admin") ||
                 User.IsInRole("Pharmacist"))
            {
                <a asp-controller="Purchase"
                   asp-action="Create"
                   class="btn btn-primary">

                    + New Purchase

                </a>
            }

        </div>

    </div>

</div>


<!-- =========================================
     STATISTICS
     ========================================= -->

<div class="row g-4 mb-4">


    <!-- MEDICINES -->

    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-icon medicine-icon">
                ✚
            </div>

            <div class="stat-content">

                <span>
                    Total Medicines
                </span>

                <strong>
                    @Model.TotalMedicines
                </strong>

                <small>
                    Available medicines
                </small>

            </div>

        </div>

    </div>


    <!-- STOCK -->

    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-icon stock-icon">
                ▦
            </div>

            <div class="stat-content">

                <span>
                    Total Stock
                </span>

                <strong>
                    @Model.TotalStock
                </strong>

                <small>
                    Units currently available
                </small>

            </div>

        </div>

    </div>


    <!-- SALES -->

    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-icon sales-icon">
                $
            </div>

            <div class="stat-content">

                <span>
                    Today's Sales
                </span>

                <strong>
                    @Model.TodaySalesCount
                </strong>

                <small>
                    Transactions today
                </small>

            </div>

        </div>

    </div>


    <!-- REVENUE -->

    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-icon revenue-icon">
                $
            </div>

            <div class="stat-content">

                <span>
                    Today's Revenue
                </span>

                <strong class="text-success">
                    $@Model.TodaySalesAmount.ToString("N2")
                </strong>

                <small>
                    Sales revenue today
                </small>

            </div>

        </div>

    </div>

</div>


<!-- =========================================
     PURCHASE SUMMARY
     ADMIN + PHARMACIST
     ========================================= -->
@if (User.IsInRole("Admin") ||
     User.IsInRole("Pharmacist"))
{
    <div class="row g-4 mb-4">


        <!-- PURCHASE SUMMARY -->

        <div class="col-xl-6">

            <div class="dashboard-section-card h-100">

                <div class="section-header">

                    <strong>
                        Purchase Overview
                    </strong>

                    <a asp-controller="Purchase"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary">

                        View All

                    </a>

                </div>

                <div class="section-body">

                    <div class="row text-center">

                        <div class="col-6">

                            <div class="text-muted small mb-1">
                                Total Purchases
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.TotalPurchases
                            </div>

                            <small class="text-muted">
                                Purchase transactions
                            </small>

                        </div>


                        <div class="col-6 border-start">

                            <div class="text-muted small mb-1">
                                Purchase Amount
                            </div>

                            <div class="fs-3 fw-bold">
                                $@Model.TotalPurchaseAmount.ToString("N2")
                            </div>

                            <small class="text-muted">
                                Total purchase value
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- QUICK ACTIONS -->

        <div class="col-xl-6">

            <div class="dashboard-section-card h-100">

                <div class="section-header">

                    <strong>
                        Quick Actions
                    </strong>

                </div>

                <div class="section-body">

                    <a asp-controller="Medicine"
                       asp-action="Create"
                       class="quick-action btn btn-outline-primary me-2 mb-2">

                        + Add Medicine

                    </a>

                    <a asp-controller="Purchase"
                       asp-action="Create"
                       class="quick-action btn btn-outline-primary me-2 mb-2">

                        + New Purchase

                    </a>

                    <a asp-controller="Sale"
                       asp-action="Create"
                       class="quick-action btn btn-outline-success me-2 mb-2">

                        + New Sale

                    </a>

                    <a asp-controller="Medicine"
                       asp-action="Index"
                       class="quick-action btn btn-outline-secondary me-2 mb-2">

                        View Medicines

                    </a>

                </div>

            </div>

        </div>

    </div>
}
else
{
    <!-- =========================================
         STAFF QUICK ACTIONS
         ========================================= -->

    <div class="row g-4 mb-4">

        <div class="col-12">

            <div class="dashboard-section-card">

                <div class="section-header">

                    <strong>
                        Quick Actions
                    </strong>

                </div>

                <div class="section-body">

                    <a asp-controller="Medicine"
                       asp-action="Create"
                       class="quick-action btn btn-outline-primary me-2 mb-2">

                        + Add Medicine

                    </a>

                    <a asp-controller="Sale"
                       asp-action="Create"
                       class="quick-action btn btn-outline-success me-2 mb-2">

                        + New Sale

                    </a>

                    <a asp-controller="Medicine"
                       asp-action="Index"
                       class="quick-action btn btn-outline-secondary me-2 mb-2">

                        View Medicines

                    </a>

                </div>

            </div>

        </div>

    </div>
}


<!-- =========================================
     ALERTS
     ========================================= -->

<div class="row g-4 mb-4">


    <!-- LOW STOCK -->

    <div class="col-xl-4 col-md-6">

        <div class="dashboard-section-card h-100">

            <div class="section-header">

                <strong>
                    🔴 Low Stock
                </strong>

                <span class="badge bg-danger">
                    @Model.LowStockMedicines.Count
                </span>

            </div>

            <div class="section-body">

                @if (Model.LowStockMedicines.Count == 0)
                {
                    <div class="dashboard-empty">

                        <div class="dashboard-empty-icon">
                            ✓
                        </div>

                        No low-stock medicines.

                    </div>
                }
                else
                {
                    @foreach (var medicine in
                        Model.LowStockMedicines.Take(5))
                    {
                        <div class="dashboard-alert-item">

                            <div class="d-flex justify-content-between">

                                <strong>
                                    @medicine.MedicineName
                                </strong>

                                <span class="badge bg-danger">
                                    @medicine.Quantity
                                </span>

                            </div>

                            <small class="text-muted">
                                Batch:
                                @(medicine.BatchNo ?? "-")
                            </small>

                        </div>
                    }
                }

            </div>

        </div>

    </div>


    <!-- EXPIRING SOON -->

    <div class="col-xl-4 col-md-6">

        <div class="dashboard-section-card h-100">

            <div class="section-header">

                <strong>
                    🟠 Expiring Soon
                </strong>

                <span class="badge bg-warning text-dark">
                    @Model.ExpiringSoonMedicines.Count
                </span>

            </div>

            <div class="section-body">

                @if (Model.ExpiringSoonMedicines.Count == 0)
                {
                    <div class="dashboard-empty">

                        <div class="dashboard-empty-icon">
                            ✓
                        </div>

                        No medicines expiring
                        within 30 days.

                    </div>
                }
                else
                {
                    @foreach (var medicine in
                        Model.ExpiringSoonMedicines.Take(5))
                    {
                        <div class="dashboard-alert-item">

                            <strong>
                                @medicine.MedicineName
                            </strong>

                            <br />

                            <small class="text-warning">
                                Expiry:
                                @(medicine.ExpiryDate.HasValue
                                    ? medicine.ExpiryDate.Value
                                        .ToString("dd-MM-yyyy")
                                    : "-")
                            </small>

                        </div>
                    }
                }

            </div>

        </div>

    </div>


    <!-- EXPIRED -->

    <div class="col-xl-4 col-md-6">

        <div class="dashboard-section-card h-100">

            <div class="section-header">

                <strong>
                    🔴 Expired
                </strong>

                <span class="badge bg-dark">
                    @Model.ExpiredMedicines.Count
                </span>

            </div>

            <div class="section-body">

                @if (Model.ExpiredMedicines.Count == 0)
                {
                    <div class="dashboard-empty">

                        <div class="dashboard-empty-icon">
                            ✓
                        </div>

                        No expired medicines.

                    </div>
                }
                else
                {
                    @foreach (var medicine in
                        Model.ExpiredMedicines.Take(5))
                    {
                        <div class="dashboard-alert-item">

                            <strong>
                                @medicine.MedicineName
                            </strong>

                            <br />

                            <small class="text-danger">
                                Expired:
                                @(medicine.ExpiryDate.HasValue
                                    ? medicine.ExpiryDate.Value
                                        .ToString("dd-MM-yyyy")
                                    : "-")
                            </small>

                        </div>
                    }
                }

            </div>

        </div>

    </div>

</div>


<!-- =========================================
     RECENT TRANSACTIONS
     ========================================= -->

<div class="row g-4 mb-4">


    <!-- RECENT SALES -->

    <div class="col-xl-6">

        <div class="dashboard-section-card h-100">

            <div class="section-header">

                <strong>
                    Recent Sales
                </strong>

                <a asp-controller="Sale"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary">

                    View All

                </a>

            </div>

            <div class="p-0">

                @if (Model.RecentSales.Count == 0)
                {
                    <div class="dashboard-empty">

                        <div class="dashboard-empty-icon">
                            $
                        </div>

                        No sales found.

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover">

                            <thead>

                                <tr>

                                    <th>
                                        Invoice
                                    </th>

                                    <th>
                                        Customer
                                    </th>

                                    <th>
                                        Date
                                    </th>

                                    <th class="text-end">
                                        Total
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var sale in
                                    Model.RecentSales)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @(sale.InvoiceNo ?? "-")
                                            </strong>
                                        </td>

                                        <td>
                                            @(sale.CustomerName ?? "-")
                                        </td>

                                        <td>
                                            @sale.SaleDate.ToString(
                                                "dd-MM-yyyy HH:mm")
                                        </td>

                                        <td class="text-end fw-semibold">
                                            $@sale.TotalAmount.ToString("N2")
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- RECENT PURCHASES -->
    @if (User.IsInRole("Admin") ||
             User.IsInRole("Pharmacist"))
    {
        <div class="col-xl-6">

            <div class="dashboard-section-card h-100">

                <div class="section-header">

                    <strong>
                        Recent Purchases
                    </strong>

                    <a asp-controller="Purchase"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary">

                        View All

                    </a>

                </div>

                <div class="p-0">

                    @if (Model.RecentPurchases.Count == 0)
                    {
                        <div class="dashboard-empty">

                            <div class="dashboard-empty-icon">
                                $
                            </div>

                            No purchases found.

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover">

                                <thead>

                                    <tr>

                                        <th>
                                            Purchase ID
                                        </th>

                                        <th>
                                            Date
                                        </th>

                                        <th class="text-end">
                                            Total
                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var purchase in
                                        Model.RecentPurchases)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    #@purchase.PurchaseId
                                                </strong>
                                            </td>

                                            <td>
                                                @purchase.PurchaseDate.ToString(
                                                    "dd-MM-yyyy HH:mm")
                                            </td>

                                            <td class="text-end fw-semibold">
                                                $@purchase.TotalAmount.ToString("N2")
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>
    }

</div>