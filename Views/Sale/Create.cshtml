@model PharmacyManagement.Models.Sale

@{
    ViewData["Title"] = "New Sale";

    var medicines = ViewBag.Medicines
        as IEnumerable<PharmacyManagement.Models.Medicine>
        ?? Enumerable.Empty<PharmacyManagement.Models.Medicine>();
}

<div class="pm-sale-create-page">

    <!-- Header -->

    <div class="pm-page-header-card mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="pm-page-header-icon">
                    ₹
                </span>

                <span class="text-success small fw-semibold">
                    BILLING
                </span>

            </div>

            <h2 class="mb-1">
                New Sale
            </h2>

            <p class="text-muted mb-0">
                Create a customer bill and update medicine stock.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            ← Back to Sales

        </a>

    </div>


    <form asp-action="Create"
          method="post"
          id="saleForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger mb-4">
        </div>


        <div class="row g-4">

            <!-- LEFT -->

            <div class="col-xl-8">

                <!-- Customer -->

                <div class="pm-sale-form-card mb-4">

                    <div class="pm-sale-form-header">

                        <div class="pm-sale-form-icon pm-blue">
                            👤
                        </div>

                        <div>

                            <strong>
                                Customer Information
                            </strong>

                            <small>
                                Enter customer and invoice details
                            </small>

                        </div>

                    </div>


                    <div class="pm-sale-form-body">

                        <div class="row g-3">

                            <div class="col-md-4">

                                <label asp-for="CustomerName"
                                       class="form-label">
                                    Customer Name
                                </label>

                                <input asp-for="CustomerName"
                                       class="form-control"
                                       placeholder="Walk-in customer" />

                            </div>


                            <div class="col-md-4">

                                <label asp-for="CustomerMobile"
                                       class="form-label">
                                    Mobile Number
                                </label>

                                <input asp-for="CustomerMobile"
                                       class="form-control"
                                       placeholder="Optional" />

                            </div>


                            <div class="col-md-4">

                                <label asp-for="InvoiceNo"
                                       class="form-label">
                                    Invoice Number
                                </label>

                                <div class="pm-auto-invoice">
                                    <input asp-for="InvoiceNo"
                                           class="form-control"
                                           placeholder="Invoice-no.will be auto generated "
                                           readonly />

                                    <span class="pm-auto-invoice-badge">
                                      
                                    </span>
                                </div>

                                <small class="text-muted">
                                   
                                </small>

                            </div>


                            <div class="col-md-5">

                                <label asp-for="SaleDate"
                                       class="form-label">
                                    Sale Date
                                </label>

                                <input asp-for="SaleDate"
                                       type="datetime-local"
                                       class="form-control" />

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Items -->

                <div class="pm-sale-form-card">

                    <div class="pm-sale-form-header pm-sale-items-header">

                        <div class="d-flex align-items-center gap-3">

                            <div class="pm-sale-form-icon pm-green">
                                +
                            </div>

                            <div>

                                <strong>
                                    Sale Items
                                </strong>

                                <small>
                                    Select medicines and quantities
                                </small>

                            </div>

                        </div>


                        <button type="button"
                                class="btn btn-success"
                                id="addItemBtn">

                            + Add Medicine

                        </button>

                    </div>


                    <div class="pm-sale-items-wrapper">

                        <div class="table-responsive">

                            <table class="table pm-sale-create-table">

                                <thead>

                                    <tr>

                                        <th>
                                            Medicine
                                        </th>

                                        <th>
                                            Available
                                        </th>

                                        <th>
                                            Quantity
                                        </th>

                                        <th>
                                            Selling Price
                                        </th>

                                        <th>
                                            Total
                                        </th>

                                        <th>
                                            Action
                                        </th>

                                    </tr>

                                </thead>

                                <tbody id="itemsBody">
                                </tbody>

                            </table>

                        </div>


                        <div id="emptyMessage"
                             class="pm-sale-empty-items">

                            <div>
                                +
                            </div>

                            <strong>
                                No medicines added
                            </strong>

                            <span>
                                Click "Add Medicine" to add items to this bill.
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- RIGHT -->

            <div class="col-xl-4">

                <div class="pm-sale-summary-card">

                    <div class="pm-sale-summary-header">

                        <strong>
                            Bill Summary
                        </strong>

                        <span>
                            LIVE
                        </span>

                    </div>


                    <div class="pm-sale-summary-body">

                        <div class="pm-bill-line">

                            <span>
                                Subtotal
                            </span>

                            <strong>
                                ₹<span id="subtotal">0.00</span>
                            </strong>

                        </div>


                        <div class="pm-bill-line pm-discount-line">

                            <span>
                                Discount
                            </span>

                            <div class="pm-discount-input">

                                <span>₹</span>

                                <input type="number"
                                       asp-for="Discount"
                                       id="discount"
                                       class="form-control"
                                       min="0"
                                       step="0.01"
                                       value="0" />

                            </div>

                        </div>


                        <hr />


                        <div class="pm-grand-total-line">

                            <span>
                                Grand Total
                            </span>

                            <strong>
                                ₹<span id="grandTotal">0.00</span>
                            </strong>

                        </div>


                        <div class="pm-sale-summary-note">

                            <span>✓</span>

                            Stock will be reduced after
                            completing the sale.

                        </div>

                    </div>


                    <div class="pm-sale-summary-footer">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            Cancel

                        </a>

                        <button type="submit"
                                class="btn btn-success">

                            Complete Sale

                        </button>

                    </div>

                </div>


                <div class="pm-sale-help-card mt-3">

                    <div class="pm-sale-help-icon">
                        i
                    </div>

                    <div>

                        <strong>
                            Billing tip
                        </strong>

                        <p>
                            Select a medicine to automatically
                            load its current selling price and
                            available stock.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        const medicines = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(
                                    medicines.Select(m => new
                            {
                                id = m.MedicineId,
                                            name = m.MedicineName,
                                            stock = m.Quantity,
                                            price = m.SellingPrice
                            })
                    )
                    );

        let itemIndex = 0;


        // =========================================================
        // MEDICINE OPTIONS
        // =========================================================

        function createMedicineOptions() {

            let options =
                '<option value="">-- Select Medicine --</option>';

            medicines.forEach(function(medicine) {

                options += `
                        <option value="${medicine.id}">
                            ${medicine.name}
                        </option>
                    `;

            });

            return options;
        }


        // =========================================================
        // FIND MEDICINE
        // =========================================================

        function getMedicine(id) {

            return medicines.find(
                m => m.id === Number(id)
            );

        }


        // =========================================================
        // UPDATE MEDICINE ROW
        // =========================================================

        function updateMedicineRow(row) {

            const select =
                row.querySelector(".pm-medicine");

            const stock =
                row.querySelector(".pm-available-stock");

            const price =
                row.querySelector(".pm-selling-price");

            const quantity =
                row.querySelector(".pm-quantity");


            if (!select || !stock || !price || !quantity) {
                return;
            }


            const medicine =
                getMedicine(select.value);


            // No medicine selected
            if (!medicine) {

                stock.textContent = "-";

                price.value = "0";

                quantity.max = "";

                updateTotals();

                return;
            }


            // Available stock
            stock.textContent =
                medicine.stock;


            // Selling price
            price.value =
                Number(medicine.price).toFixed(2);


            // Maximum quantity
            quantity.max =
                medicine.stock;


            // If entered quantity is greater than stock
            if (
                Number(quantity.value) >
                medicine.stock
            ) {

                quantity.value =
                    medicine.stock;

            }


            updateTotals();
        }


        // =========================================================
        // UPDATE TOTALS
        // =========================================================

        function updateTotals() {

            let subtotal = 0;


            document
                .querySelectorAll(".sale-item")
                .forEach(function(row) {

                    const quantityInput =
                        row.querySelector(".pm-quantity");

                    const priceInput =
                        row.querySelector(".pm-selling-price");

                    const itemTotal =
                        row.querySelector(".pm-item-total");


                    if (!quantityInput ||
                        !priceInput ||
                        !itemTotal) {

                        return;
                    }


                    const quantity =
                        parseFloat(
                            quantityInput.value
                        ) || 0;


                    const price =
                        parseFloat(
                            priceInput.value
                        ) || 0;


                    const total =
                        quantity * price;


                    itemTotal.textContent =
                        total.toFixed(2);


                    subtotal += total;

                });


            // Discount
            const discountInput =
                document.getElementById("discount");


            const discount =
                parseFloat(
                    discountInput?.value
                ) || 0;


            // Grand total
            let grandTotal =
                subtotal - discount;


            if (grandTotal < 0) {
                grandTotal = 0;
            }


            // Update UI
            document.getElementById("subtotal")
                .textContent =
                subtotal.toFixed(2);


            document.getElementById("grandTotal")
                .textContent =
                grandTotal.toFixed(2);

        }


        // =========================================================
        // EMPTY MESSAGE
        // =========================================================

        function updateEmptyMessage() {

            const rows =
                document.querySelectorAll(".sale-item");


            const emptyMessage =
                document.getElementById("emptyMessage");


            if (!emptyMessage) {
                return;
            }


            emptyMessage.style.display =
                rows.length === 0
                    ? "flex"
                    : "none";

        }


        // =========================================================
        // ADD MEDICINE ROW
        // =========================================================

        function addItem() {

            const tbody =
                document.getElementById("itemsBody");


            const row =
                document.createElement("tr");


            row.className =
                "sale-item";


            row.innerHTML = `

                    <td>

                        <select
                            name="Items[${itemIndex}].MedicineId"
                            class="form-select pm-medicine"
                            required>

                            ${createMedicineOptions()}

                        </select>

                    </td>


                    <td>

                        <span
                            class="pm-available-stock pm-stock-number">

                            -

                        </span>

                    </td>


                    <td>

                        <input
                            type="number"
                            name="Items[${itemIndex}].Quantity"
                            class="form-control pm-quantity"
                            min="1"
                            value="1"
                            required />

                    </td>


                    <td>

                        <div class="pm-price-input">

                            <span>₹</span>

                            <input
                                type="number"
                                name="Items[${itemIndex}].SellingPrice"
                                class="form-control pm-selling-price"
                                min="0"
                                step="0.01"
                                value="0"
                                required />

                        </div>

                    </td>


                    <td>

                        <strong>
                            ₹<span class="pm-item-total">
                                0.00
                            </span>
                        </strong>

                    </td>


                    <td>

                        <button
                            type="button"
                            class="pm-remove-item"
                            title="Remove">

                            ×

                        </button>

                    </td>

                `;


            tbody.appendChild(row);


            itemIndex++;


            updateEmptyMessage();

            updateTotals();

        }


        // =========================================================
        // PAGE INITIALIZATION
        // =========================================================

        document.addEventListener(
            "DOMContentLoaded",
            function() {


                // Add medicine button
                document
                    .getElementById("addItemBtn")
                    .addEventListener(
                        "click",
                        addItem
                    );


                // Medicine selection
                document
                    .getElementById("itemsBody")
                    .addEventListener(
                        "change",
                        function(event) {

                            if (
                                event.target.classList.contains(
                                    "pm-medicine"
                                )
                            ) {

                                const row =
                                    event.target.closest(
                                        ".sale-item"
                                    );


                                if (row) {

                                    updateMedicineRow(row);

                                }

                            }

                        }
                    );


                // Quantity / price changes
                document
                    .getElementById("itemsBody")
                    .addEventListener(
                        "input",
                        function() {

                            updateTotals();

                        }
                    );


                // Discount changes
                document
                    .getElementById("discount")
                    .addEventListener(
                        "input",
                        function() {

                            updateTotals();

                        }
                    );


                // Remove medicine
                document
                    .getElementById("itemsBody")
                    .addEventListener(
                        "click",
                        function(event) {

                            if (
                                event.target.classList.contains(
                                    "pm-remove-item"
                                )
                            ) {

                                const row =
                                    event.target.closest(
                                        ".sale-item"
                                    );


                                if (row) {

                                    row.remove();

                                    updateEmptyMessage();

                                    updateTotals();

                                }

                            }

                        }
                    );


                // Add first row automatically
                addItem();

            }
        );

    </script>
}