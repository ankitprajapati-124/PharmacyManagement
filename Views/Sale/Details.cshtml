@model PharmacyManagement.Models.Sale

@{
    ViewData["Title"] = "Sale Details";

    var saleItems =
        Model.Items ?? new List<PharmacyManagement.Models.SaleItem>();

    var subtotal =
        saleItems.Sum(x => x.Quantity * x.SellingPrice);

    var discount = Model.Discount;

    var calculatedGrandTotal =
        subtotal - discount;

    var grandTotal =
        Model.TotalAmount;

    var invoiceNumber =
        Model.InvoiceNo ?? Model.SaleId.ToString();

    var customerName =
        string.IsNullOrWhiteSpace(Model.CustomerName)
            ? "Walk-in Customer"
            : Model.CustomerName;

    var customerMobile =
        string.IsNullOrWhiteSpace(Model.CustomerMobile)
            ? "-"
            : Model.CustomerMobile;
}


<div class="pm-sale-details-page">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="pm-page-header-card mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="pm-page-header-icon">
                    #
                </span>

                <span class="text-primary small fw-semibold">
                    SALES
                </span>

            </div>


            <h2 class="mb-1">
                Sale Details
            </h2>


            <p class="text-muted mb-0">
                Invoice #@invoiceNumber
            </p>

        </div>


        <div class="d-flex gap-2 flex-wrap">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                ← Back

            </a>


            <a asp-action="Delete"
               asp-route-id="@Model.SaleId"
               class="btn btn-outline-danger">

                Delete

            </a>


            <button type="button"
                    class="btn btn-primary"
                    onclick="window.print()">

                Print Invoice

            </button>

        </div>

    </div>



    <!-- =====================================================
         INVOICE SUMMARY
         ===================================================== -->

    <div class="pm-invoice-card mb-4">


        <!-- Invoice top -->

        <div class="pm-invoice-top">

            <div>

                <span class="pm-invoice-label">
                    INVOICE
                </span>


                <h3>
                    #@invoiceNumber
                </h3>

            </div>


            <div class="pm-invoice-total-box">

                <span>
                    Grand Total
                </span>


                <strong>
                    ₹@grandTotal.ToString("N2")
                </strong>

            </div>

        </div>



        <!-- Invoice information -->

        <div class="pm-invoice-info-grid">


            <!-- Customer -->

            <div>

                <span>
                    Customer
                </span>

                <strong>
                    @customerName
                </strong>

            </div>


            <!-- Mobile -->

            <div>

                <span>
                    Mobile
                </span>

                <strong>
                    @customerMobile
                </strong>

            </div>


            <!-- Date -->

            <div>

                <span>
                    Sale Date
                </span>

                <strong>
                    @Model.SaleDate.ToString("dd-MM-yyyy HH:mm")
                </strong>

            </div>


            <!-- Sale ID -->

            <div>

                <span>
                    Sale ID
                </span>

                <strong>
                    #@Model.SaleId
                </strong>

            </div>

        </div>

    </div>



    <!-- =====================================================
         ITEMS
         ===================================================== -->

    <div class="pm-invoice-card">


        <!-- Items header -->

        <div class="pm-invoice-section-header">

            <div>

                <strong>
                    Items
                </strong>


                <small>
                    @saleItems.Count
                    @(saleItems.Count == 1 ? "item" : "items")
                    in this invoice
                </small>

            </div>

        </div>



        @if (saleItems.Count == 0)
        {
            <!-- EMPTY STATE -->

            <div class="text-center text-muted py-5">

                <div class="mb-2"
                     style="font-size: 28px;">
                    ∅
                </div>

                <strong>
                    No sale items found.
                </strong>

                <div class="small mt-1">
                    This invoice does not contain any item records.
                </div>

            </div>
        }
        else
        {
            <!-- =================================================
                 ITEMS TABLE
                 ================================================= -->

            <div class="table-responsive pm-sale-invoice-scroll">

                <table class="table pm-invoice-table">

                    <thead>

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Medicine
                            </th>

                            <th class="text-end">
                                Quantity
                            </th>

                            <th class="text-end">
                                Price
                            </th>

                            <th class="text-end">
                                Total
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in saleItems)
                        {
                            <tr>

                                <!-- ID -->

                                <td>
                                    @item.SaleItemId
                                </td>


                                <!-- Medicine -->

                                <td>

                                    <strong>
                                        @(item.MedicineName ?? "Unknown Medicine")
                                    </strong>

                                </td>


                                <!-- Quantity -->

                                <td class="text-end">
                                    @item.Quantity
                                </td>


                                <!-- Price -->

                                <td class="text-end">

                                    ₹@item.SellingPrice.ToString("N2")

                                </td>


                                <!-- Total -->

                                <td class="text-end">

                                    <strong>
                                        ₹@item.TotalPrice.ToString("N2")
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>



            <!-- =================================================
                 TOTALS
                 ================================================= -->

            <div class="pm-invoice-totals">


                <!-- Subtotal -->

                <div class="pm-invoice-total-line">

                    <span>
                        Subtotal
                    </span>

                    <strong>
                        ₹@subtotal.ToString("N2")
                    </strong>

                </div>


                <!-- Discount -->

                <div class="pm-invoice-total-line">

                    <span>
                        Discount
                    </span>

                    <strong class="pm-discount-value">
                        ₹@discount.ToString("N2")
                    </strong>

                </div>


                <!-- Calculated total -->

                <div class="pm-invoice-total-line">

                    <span>
                        After Discount
                    </span>

                    <strong>
                        ₹@calculatedGrandTotal.ToString("N2")
                    </strong>

                </div>


                <!-- Final total -->

                <div class="pm-invoice-grand-line">

                    <span>
                        Grand Total
                    </span>

                    <strong>
                        ₹@grandTotal.ToString("N2")
                    </strong>

                </div>

            </div>

        }

    </div>

</div>



<!-- =========================================================
     PRINT STYLES
     ========================================================= -->

<style>

    @@media print {

        body {
            background: #ffffff !important;
        }

        nav,
        footer,
        .navbar,
        .sidebar,
        .pm-sidebar,
        .btn {
            display: none !important;
        }

        .pm-app-shell,
        .pm-main-content,
        .pm-page-content {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }

        .pm-page-header-card {
            border: none !important;
            box-shadow: none !important;
            margin-bottom: 15px !important;
        }

        .pm-invoice-card {
            border: 1px solid #dddddd !important;
            box-shadow: none !important;
            break-inside: avoid;
        }

        .pm-invoice-table {
            min-width: 100% !important;
        }

        .pm-invoice-totals {
            width: 320px !important;
        }
    }

</style>