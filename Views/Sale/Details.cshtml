@model PharmacyManagement.Models.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Sale Details</h2>
        <p class="text-muted mb-0">
            Sale #@Model.SaleId
        </p>
    </div>

    <div>
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.SaleId"
           class="btn btn-outline-danger">
            Delete
        </a>

        <button type="button"
                class="btn btn-primary"
                onclick="window.print()">
            Print
        </button>
    </div>
</div>


<!-- Sale Information -->

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Sale Information</strong>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-3">
                <strong>Sale ID</strong>
                <div>
                    @Model.SaleId
                </div>
            </div>

            <div class="col-md-3">
                <strong>Customer</strong>
                <div>
                    @(Model.CustomerName ?? "-")
                </div>
            </div>

            <div class="col-md-3">
                <strong>Mobile</strong>
                <div>
                    @(Model.CustomerMobile ?? "-")
                </div>
            </div>

            <div class="col-md-3">
                <strong>Invoice No.</strong>
                <div>
                    @(Model.InvoiceNo ?? "-")
                </div>
            </div>

        </div>

        <hr />

        <div class="row">

            <div class="col-md-3">
                <strong>Sale Date</strong>
                <div>
                    @Model.SaleDate.ToString("dd-MM-yyyy HH:mm")
                </div>
            </div>

        </div>

    </div>

</div>


<!-- Sale Items -->

<div class="card shadow-sm">

    <div class="card-header">
        <strong>Sale Items</strong>
    </div>

    <div class="card-body">

        @if (Model.Items.Count == 0)
        {
            <div class="text-center text-muted py-4">
                No sale items found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Medicine
                            </th>

                            <th class="text-end">
                                Quantity
                            </th>

                            <th class="text-end">
                                Selling Price
                            </th>

                            <th class="text-end">
                                Total
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    @item.SaleItemId
                                </td>

                                <td>
                                    @item.MedicineName
                                </td>

                                <td class="text-end">
                                    @item.Quantity
                                </td>

                                <td class="text-end">
                                    ₹@item.SellingPrice.ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₹@item.TotalPrice.ToString("N2")
                                </td>

                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <th colspan="4"
                                class="text-end">
                                Subtotal
                            </th>

                            <th class="text-end">
                                ₹@(
                                (Model.TotalAmount +
                                 Model.Discount)
                                .ToString("N2")
                                                            )
                            </th>

                        </tr>

                        <tr>

                            <th colspan="4"
                                class="text-end">
                                Discount
                            </th>

                            <th class="text-end">
                                ₹@Model.Discount.ToString("N2")
                            </th>

                        </tr>

                        <tr>

                            <th colspan="4"
                                class="text-end">
                                <strong>Grand Total</strong>
                            </th>

                            <th class="text-end">
                                <strong>
                                    ₹@Model.TotalAmount.ToString("N2")
                                </strong>
                            </th>

                        </tr>

                    </tfoot>

                </table>

            </div>
        }

    </div>

</div>


<style>
    @@media print {
        .btn,
        nav,
        footer {
            display: none !important;
        }

        .card {
            box-shadow: none !important;
            border: 1px solid #ddd;
        }

        body {
            background: white !important;
        }
    }
</style>