@model PharmacyManagement.Models.Sale

@{
    ViewData["Title"] = "Sale Details";

    var subtotal =
        Model.TotalAmount + Model.Discount;
}

<div class="sale-details-page">

    <div class="page-header-card mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">

                <span class="page-header-icon">
                    #
                </span>

                <span class="text-primary small fw-semibold">
                    SALES
                </span>

            </div>

            <h2 class="mb-1">
                Sale Details
            </h2>

            <p class="text-muted mb-0">
                Invoice #@(Model.InvoiceNo ?? Model.SaleId.ToString())
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                ← Back

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.SaleId"
               class="btn btn-outline-danger">

                Delete

            </a>

            <button type="button"
                    class="btn btn-primary"
                    onclick="window.print()">

                Print Invoice

            </button>

        </div>

    </div>


    <!-- Invoice Header -->

    <div class="invoice-card mb-4">

        <div class="invoice-top">

            <div>

                <span class="invoice-label">
                    INVOICE
                </span>

                <h3>
                    #@(Model.InvoiceNo ?? Model.SaleId.ToString())
                </h3>

            </div>

            <div class="invoice-total-box">

                <span>
                    Grand Total
                </span>

                <strong>
                    ₹@Model.TotalAmount.ToString("N2")
                </strong>

            </div>

        </div>


        <div class="invoice-info-grid">

            <div>

                <span>
                    Customer
                </span>

                <strong>
                    @(Model.CustomerName ?? "Walk-in Customer")
                </strong>

            </div>


            <div>

                <span>
                    Mobile
                </span>

                <strong>
                    @(Model.CustomerMobile ?? "-")
                </strong>

            </div>


            <div>

                <span>
                    Sale Date
                </span>

                <strong>
                    @Model.SaleDate.ToString("dd-MM-yyyy HH:mm")
                </strong>

            </div>


            <div>

                <span>
                    Sale ID
                </span>

                <strong>
                    #@Model.SaleId
                </strong>

            </div>

        </div>

    </div>


    <!-- Items -->

    <div class="invoice-card">

        <div class="invoice-section-header">

            <div>

                <strong>
                    Items
                </strong>

                <small>
                    @Model.Items.Count item(s) in this invoice
                </small>

            </div>

        </div>


        @if (Model.Items.Count == 0)
        {
            <div class="text-center text-muted py-5">
                No sale items found.
            </div>
        }
        else
        {
            <div class="table-responsive sale-invoice-scroll">

                <table class="table invoice-table">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Medicine</th>

                            <th class="text-end">
                                Quantity
                            </th>

                            <th class="text-end">
                                Price
                            </th>

                            <th class="text-end">
                                Total
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    @item.SaleItemId
                                </td>

                                <td>

                                    <strong>
                                        @item.MedicineName
                                    </strong>

                                </td>

                                <td class="text-end">
                                    @item.Quantity
                                </td>

                                <td class="text-end">
                                    ₹@item.SellingPrice.ToString("N2")
                                </td>

                                <td class="text-end">

                                    <strong>
                                        ₹@item.TotalPrice.ToString("N2")
                                    </strong>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="invoice-totals">

                <div class="invoice-total-line">

                    <span>
                        Subtotal
                    </span>

                    <strong>
                        ₹@subtotal.ToString("N2")
                    </strong>

                </div>


                <div class="invoice-total-line">

                    <span>
                        Discount
                    </span>

                    <strong class="discount-value">
                        ₹@Model.Discount.ToString("N2")
                    </strong>

                </div>


                <div class="invoice-grand-line">

                    <span>
                        Grand Total
                    </span>

                    <strong>
                        ₹@Model.TotalAmount.ToString("N2")
                    </strong>

                </div>

            </div>
        }

    </div>

</div>


<style>

    @@media print {

        .btn,
        nav,
        footer {
            display: none !important;
        }

        .page-header-card {
            border: none !important;
            box-shadow: none !important;
        }

        .invoice-card {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }

        body {
            background: white !important;
        }
    }

</style>