@model PharmacyManagement.Models.Sale

@{
    ViewData["Title"] = "Delete Sale";
}

<div class="mb-4">
    <h2>Delete Sale</h2>

    <p class="text-muted">
        Review the sale before deleting it.
    </p>
</div>

<div class="alert alert-warning">
    <strong>Warning:</strong>
    Deleting this sale will restore the sold quantities
    back into medicine stock.
</div>


<!-- Sale Information -->

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Sale Information</strong>
    </div>

    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-4">
                Sale ID
            </dt>

            <dd class="col-sm-8">
                @Model.SaleId
            </dd>


            <dt class="col-sm-4">
                Customer
            </dt>

            <dd class="col-sm-8">
                @(Model.CustomerName ?? "-")
            </dd>


            <dt class="col-sm-4">
                Mobile
            </dt>

            <dd class="col-sm-8">
                @(Model.CustomerMobile ?? "-")
            </dd>


            <dt class="col-sm-4">
                Sale Date
            </dt>

            <dd class="col-sm-8">
                @Model.SaleDate.ToString("dd-MM-yyyy HH:mm")
            </dd>


            <dt class="col-sm-4">
                Invoice No.
            </dt>

            <dd class="col-sm-8">
                @(Model.InvoiceNo ?? "-")
            </dd>


            <dt class="col-sm-4">
                Discount
            </dt>

            <dd class="col-sm-8">
                ₹@Model.Discount.ToString("N2")
            </dd>


            <dt class="col-sm-4">
                Total Amount
            </dt>

            <dd class="col-sm-8">
                <strong>
                    ₹@Model.TotalAmount.ToString("N2")
                </strong>
            </dd>

        </dl>

    </div>

</div>


<!-- Sale Items -->

<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Sale Items</strong>
    </div>

    <div class="card-body">

        @if (Model.Items.Count == 0)
        {
            <div class="text-center text-muted py-4">
                No sale items found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-bordered">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Medicine
                            </th>

                            <th class="text-end">
                                Quantity Sold
                            </th>

                            <th class="text-end">
                                Selling Price
                            </th>

                            <th class="text-end">
                                Total
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    @item.MedicineName
                                </td>

                                <td class="text-end">
                                    @item.Quantity
                                </td>

                                <td class="text-end">
                                    ₹@item.SellingPrice.ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₹@item.TotalPrice.ToString("N2")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


<!-- Delete Form -->

<form asp-action="DeleteConfirmed"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="id"
           value="@Model.SaleId" />

    <div class="d-flex justify-content-end gap-2">

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

        <button type="submit"
                class="btn btn-danger">
            Delete Sale & Restore Stock
        </button>

    </div>

</form>