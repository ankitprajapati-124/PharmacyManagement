@model IReadOnlyList<PharmacyManagement.Models.Sale>

@{
    ViewData["Title"] = "Sales";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Sales</h2>
        <p class="text-muted mb-0">
            Manage pharmacy sales and billing.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + New Sale
    </a>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show">
        @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @errorMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card shadow-sm">

    <div class="card-body">

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">

                <h5>No sales found</h5>

                <p class="text-muted">
                    Create your first sale to start billing.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">
                    Create Sale
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Mobile
                            </th>

                            <th>
                                Sale Date
                            </th>

                            <th>
                                Invoice No.
                            </th>

                            <th class="text-end">
                                Discount
                            </th>

                            <th class="text-end">
                                Total
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var sale in Model)
                        {
                            <tr>

                                <td>
                                    @sale.SaleId
                                </td>

                                <td>
                                    @(sale.CustomerName ?? "-")
                                </td>

                                <td>
                                    @(sale.CustomerMobile ?? "-")
                                </td>

                                <td>
                                    @sale.SaleDate.ToString(
                                        "dd-MM-yyyy HH:mm")
                                </td>

                                <td>
                                    @(sale.InvoiceNo ?? "-")
                                </td>

                                <td class="text-end">
                                    ₹@sale.Discount.ToString("N2")
                                </td>

                                <td class="text-end">
                                    <strong>
                                        ₹@sale.TotalAmount.ToString("N2")
                                    </strong>
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@sale.SaleId"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@sale.SaleId"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>