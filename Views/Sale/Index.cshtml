@model IReadOnlyList<PharmacyManagement.Models.Sale>

@{
    ViewData["Title"] = "Sales";

    var totalTransactions = Model.Count;
    var totalDiscount = Model.Sum(x => x.Discount);
    var totalSales = Model.Sum(x => x.TotalAmount);
}

<div class="pm-sales-page">

    <!-- Header -->
    <div class="pm-page-header-card mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="pm-page-header-icon">₹</span>

                <span class="text-primary small fw-semibold">
                    BILLING
                </span>
            </div>

            <h2 class="mb-1">
                Sales
            </h2>

            <p class="text-muted mb-0">
                Manage pharmacy sales, invoices and customer billing.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-success px-4">

            + New Sale

        </a>

    </div>


    <!-- Alerts -->
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <strong>Success:</strong>
            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            <strong>Error:</strong>
            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <!-- Summary -->

    <div class="row g-3 mb-4">

        <div class="col-xl-4 col-md-6">

            <div class="pm-sales-summary-card">

                <div class="pm-sales-summary-icon pm-blue">
                    #
                </div>

                <div>
                    <span>Total Transactions</span>

                    <strong>
                        @totalTransactions
                    </strong>
                </div>

            </div>

        </div>


        <div class="col-xl-4 col-md-6">

            <div class="pm-sales-summary-card">

                <div class="pm-sales-summary-icon pm-orange">
                    %
                </div>

                <div>
                    <span>Total Discount</span>

                    <strong>
                        ₹@totalDiscount.ToString("N2")
                    </strong>
                </div>

            </div>

        </div>


        <div class="col-xl-4 col-md-12">

            <div class="pm-sales-summary-card">

                <div class="pm-sales-summary-icon pm-green">
                    ₹
                </div>

                <div>
                    <span>Total Sales</span>

                    <strong class="pm-sales-total">
                        ₹@totalSales.ToString("N2")
                    </strong>
                </div>

            </div>

        </div>

    </div>


    <!-- Sales Table -->

    <div class="pm-sales-table-card">

        <div class="pm-sales-table-header">

            <div>

                <strong>
                    Sales Transactions
                </strong>

                <small>
                    Recent pharmacy billing transactions
                </small>

            </div>

            <span class="pm-sales-count-badge">
                @totalTransactions transaction@(totalTransactions == 1 ? "" : "s")
            </span>

        </div>


        @if (Model.Count == 0)
        {
            <div class="pm-sales-empty">

                <div class="pm-sales-empty-icon">
                    ₹
                </div>

                <h5>
                    No sales yet
                </h5>

                <p>
                    Create your first sale to start billing.
                </p>

                <a asp-action="Create"
                   class="btn btn-success">

                    + Create Sale

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive pm-sales-table-scroll">

                <table class="table pm-sales-table">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Customer</th>

                            <th>Mobile</th>

                            <th>Date</th>

                            <th>Invoice</th>

                            <th class="text-end">
                                Discount
                            </th>

                            <th class="text-end">
                                Total
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var sale in Model)
                        {
                            <tr>

                                <td>

                                    <span class="pm-sale-id">
                                        #@sale.SaleId
                                    </span>

                                </td>


                                <td>

                                    <div class="pm-customer-cell">

                                        <div class="pm-customer-avatar">
                                            @(string.IsNullOrWhiteSpace(sale.CustomerName)
                                                ? "C"
                                                : sale.CustomerName.Substring(0, 1).ToUpper())
                                        </div>

                                        <div>

                                            <strong>
                                                @(sale.CustomerName ?? "Walk-in Customer")
                                            </strong>

                                            <small>
                                                Customer
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <td>
                                    @(sale.CustomerMobile ?? "-")
                                </td>


                                <td>

                                    <span class="pm-sale-date">
                                        @sale.SaleDate.ToString("dd-MM-yyyy")
                                    </span>

                                    <small class="d-block text-muted">
                                        @sale.SaleDate.ToString("HH:mm")
                                    </small>

                                </td>


                                <td>

                                    @if (!string.IsNullOrWhiteSpace(sale.InvoiceNo))
                                    {
                                        <span class="pm-invoice-badge">
                                            @sale.InvoiceNo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    @if (sale.Discount > 0)
                                    {
                                        <span class="pm-discount-value">
                                            ₹@sale.Discount.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            ₹0.00
                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    <strong class="pm-sale-amount">
                                        ₹@sale.TotalAmount.ToString("N2")
                                    </strong>

                                </td>


                                <td class="text-end">

                                    <div class="pm-sale-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@sale.SaleId"
                                           class="pm-sale-action pm-view">

                                            Details

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@sale.SaleId"
                                           class="pm-sale-action pm-delete">

                                            Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <th colspan="5"
                                class="text-end">

                                Total

                            </th>

                            <th class="text-end">

                                ₹@totalDiscount.ToString("N2")

                            </th>

                            <th class="text-end">

                                ₹@totalSales.ToString("N2")

                            </th>

                            <th></th>

                        </tr>

                    </tfoot>

                </table>

            </div>
        }

    </div>

</div>